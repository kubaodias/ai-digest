# Copy to .env and fill in. .env is git-ignored; never commit it.
# `ai-digest deploy` stores the agent's settings as Telnyx secrets (the function reads them there)
# and the scripts use the rest locally.

# Sender: an address on a domain verified for sending in Telnyx Email (docs/SETUP.md, step 3).
DIGEST_EMAIL_FROM=digest@example.com

# Default recipients (comma-separated). A digest can send elsewhere with `to:` in its file.
DIGEST_EMAIL_TO=you@example.com

# Telnyx API key (Mission Control → your name → API Keys). Optional if `telnyx-edge auth api-key set` was run:
# the scripts use the key telnyx-edge stored.
TELNYX_API_KEY=

# Operator key for the agent's API (managing digests, starting runs). Leave empty: the first deploy
# creates one and writes it here. Share it only with people who should run digests.
AGENT_AUTH_KEY=

# Key that signs the thumbs links. Leave empty to have one generated and stored only on Telnyx.
# If you set it, keep it stable: changing it breaks the links in emails already sent.
FEEDBACK_KEY=

# Optional: where sign-in links for the digests page (/v1/app) go. Default: the first DIGEST_EMAIL_TO address.
ADMIN_EMAIL=

# Optional: the function's name on Telnyx Edge Compute (default ai-digest).
FUNCTION_NAME=

# Optional: the function's public URL. Normally left empty; the deploy records it in .edge/function.json.
# Set it to your custom domain (e.g. https://digest.example.com) once that domain has a certificate:
# links in emails then use it, and the deploy declares it in the function's manifest.
PUBLIC_URL=

# Copy to .env and fill in. .env is git-ignored; never commit it.
# `npm run deploy` pushes these to Telnyx secrets (the agent reads them there at
# runtime) and uses TELNYX_API_KEY for the CLI and the Agent Memory settings.

# Telnyx API key (Mission Control → your name → API Keys). Optional if you've run `telnyx-acp login`,
# but needed to apply the Agent Memory summary instructions. `telnyx-acp dev` reads it too.
TELNYX_API_KEY=

# Sender: an address on a domain verified for sending in Telnyx Email (docs/SETUP.md, step 3).
DIGEST_EMAIL_FROM=digest@example.com

# Who gets the digest: one or more addresses, comma-separated.
DIGEST_EMAIL_TO=you@example.com

# The agent's public URL. Leave empty: the first `npm run deploy` fills it in from the deploy output.
PUBLIC_URL=

# Agent Memory profile your feedback is stored under (default: reader).
DIGEST_MEMORY_PROFILE=

# Key that signs the thumbs links. Leave empty to have one generated and stored only on Telnyx.
# If you set it, keep it stable: changing it breaks the links in emails already sent.
FEEDBACK_KEY=
